<?xml version="1.0" encoding="utf-8"?>
<Mod id="demographics-watch-probe" version="1" xmlns="ModInfo">
    <Properties>
        <Name>Demographics Watch Probe (dev)</Name>
        <Description>Throwaway dev probe. Auto-loads a named save from the main menu and presses Begin Game, so a release watch can be driven hands-free over CDP. Not for release.</Description>
        <Authors>Tower</Authors>
        <Package>DemographicsWatchProbe</Package>
        <PackageSortIndex>9999</PackageSortIndex>
        <Version>0.0.1</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="ws-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>9000</LoadOrder></Properties>
            <Actions>
                <UIScripts><Item>ws-shell.js</Item></UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="ws-game" scope="game" criteria="always">
            <Properties><LoadOrder>9000</LoadOrder></Properties>
            <Actions>
                <UIScripts><Item>ws-game.js</Item></UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
