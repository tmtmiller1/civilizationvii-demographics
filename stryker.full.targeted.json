{
  "testRunner": "command",
  "commandRunner": {
    "command": "node tests/run-all.mjs crisis-cost sampler-wars wars-naming"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "ui/screen-demographics/charts/crises/crisis-cost-model.js",
    "ui/sampler/sampler-wars-detect.js",
    "ui/sampler/sampler-wars-ingest.js",
    "ui/sampler/sampler-wars-core.js",
    "ui/sampler/sampler-wars-augment.js"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 2,
  "timeoutMS": 20000,
  "thresholds": {
    "high": 75,
    "low": 60,
    "break": null
  }
}
